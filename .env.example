# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Gemini AI Key (for direct translation & example generation)
VITE_GEMINI_API_KEY=

# Optional OCR.Space API Key (https://ocr.space/ocrapi) - Engine 2 precision OCR
VITE_OCR_SPACE_API_KEY=

# Optional Microsoft Azure Translator (https://api.cognitive.microsofttranslator.com/)
VITE_AZURE_TRANSLATOR_KEY=
VITE_AZURE_TRANSLATOR_REGION=eastasia

# Optional Microsoft Azure Cognitive Speech (https://southeastasia.api.cognitive.microsofttranslator.com/)
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=southeastasia

# Optional Microsoft Azure OpenAI (gpt-4o-mini) for Thai Pronunciation & Sentence Generation
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
VITE_AZURE_OPENAI_KEY=your-azure-openai-key
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
VITE_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# LINE LIFF & LINE Login Configuration (https://developers.line.biz/)
VITE_LIFF_ID=

